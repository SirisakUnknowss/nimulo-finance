{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/lib/*": [
        "../lib/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@react-native-async-storage/async-storage": [
        "./node_modules/@react-native-async-storage/async-storage"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../lib/**/*.ts",
    "../lib/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "../lib/supabase/**",
    "../lib/**/__tests__/**"
  ]
}