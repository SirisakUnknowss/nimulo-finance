# MONO Finance environment configuration
#
# If these Supabase variables are left unset, the app automatically runs in
# DEMO MODE: a read-only, in-browser (localStorage-backed) data layer seeded
# with realistic fictional data. No real account or credentials are needed to
# explore the app in demo mode.
#
# To connect a real Supabase project instead:
# 1. Create a project at https://supabase.com
# 2. Run the SQL migrations in supabase/migrations/*.sql (in order) via the
#    Supabase SQL editor or `supabase db push`
# 3. Copy the Project URL and anon/public key from Project Settings > API
# 4. Fill in the values below and restart the dev server

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used for privileged server actions (never exposed to the
# browser). Optional: most operations work fine with RLS + anon key alone.
SUPABASE_SERVICE_ROLE_KEY=
